{
  "name": "talentminder-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:data-pipeline": "node --test tools/data-pipeline/test/*.test.mjs",
    "test:scanner": "python -m unittest discover -v -s tools/scanner -p test_talent_scanner.py",
    "data:scan": "node scripts/data-scan.mjs",
    "data:validate": "node scripts/data-validate.mjs",
    "data:generate": "node scripts/data-generate.mjs",
    "data:update": "node scripts/data-update.mjs",
    "addon:validate": "node scripts/addon-validate.mjs",
    "addon:package": "node scripts/addon-package.mjs",
    "test": "node scripts/validate.mjs",
    "package:addon": "powershell -ExecutionPolicy Bypass -File scripts/package-addon.ps1"
  },
  "dependencies": {
    "playwright": "^1.56.1"
  }
}
